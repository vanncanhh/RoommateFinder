@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject AuthApi AuthApi

<PageTitle>Quên mật khẩu – RoommateFinder</PageTitle>

<div class="container py-5" style="max-width:440px">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Quên mật khẩu</h1>
            <p class="text-secondary mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu.</p>

            <ErrorAlert Message="@_error" />

            @if (_result != null)
            {
                <div class="alert alert-success d-flex gap-2" role="status">
                    <i class="bi bi-envelope-check-fill"></i>
                    <div>@_result</div>
                </div>
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="() => _result = null">Gửi lại với email khác</button>
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="forgot">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" autocomplete="email" placeholder="email@example.com" />
                        <ValidationMessage For="() => _model.Email" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Gửi hướng dẫn
                    </button>
                </EditForm>
            }

            <div class="text-center mt-3 small"><a href="/login"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a></div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotModel _model = new();
    private bool _busy;
    private string? _error;
    private string? _result;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Backend trả cùng một thông điệp cho mọi email (không tiết lộ email có tồn tại hay không).
            var res = await AuthApi.ForgotPasswordAsync(new ForgotPasswordRequest { Email = _model.Email.Trim() });
            _result = res.Message;
        }
        catch (ApiException ex)
        {
            _error = ex.Message; // 429 khi gửi quá nhiều lần
        }
        finally
        {
            _busy = false;
        }
    }

    private class ForgotModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = "";
    }
}
