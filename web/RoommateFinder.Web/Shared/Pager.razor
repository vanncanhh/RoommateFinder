@* Phân trang. Page bắt đầu từ 1. Ẩn khi chỉ có 1 trang. *@
@if (TotalPages > 1)
{
    <nav aria-label="Phân trang" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item @(Page <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page - 1)" aria-label="Trang trước">&laquo;</button>
            </li>
            @foreach (var p in Pages())
            {
                if (p == 0)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    <li class="page-item @(p == Page ? "active" : "")">
                        <button class="page-link" @onclick="() => Go(p)">@p</button>
                    </li>
                }
            }
            <li class="page-item @(Page >= TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page + 1)" aria-label="Trang sau">&raquo;</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private async Task Go(int p)
    {
        if (p < 1 || p > TotalPages || p == Page) return;
        await PageChanged.InvokeAsync(p);
    }

    /// <summary>1 … (trang-1, trang, trang+1) … cuối; 0 = dấu ba chấm.</summary>
    private IEnumerable<int> Pages()
    {
        var set = new SortedSet<int> { 1, TotalPages };
        for (var i = Page - 1; i <= Page + 1; i++) if (i >= 1 && i <= TotalPages) set.Add(i);
        var prev = 0;
        foreach (var p in set)
        {
            if (prev != 0 && p - prev > 1) yield return 0;
            yield return p;
            prev = p;
        }
    }
}
