@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]
@inject AdminApi AdminApi

<PageTitle>Thống kê – RoommateFinder</PageTitle>

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-bar-chart me-2"></i>Thống kê</h1>
    <form class="d-flex flex-wrap align-items-end gap-2" @onsubmit="LoadAsync" @onsubmit:preventDefault="true">
        <div>
            <label class="form-label small mb-0" for="fromDate">Từ ngày</label>
            <input id="fromDate" type="date" class="form-control form-control-sm" @bind="_from" />
        </div>
        <div>
            <label class="form-label small mb-0" for="toDate">Đến ngày</label>
            <input id="toDate" type="date" class="form-control form-control-sm" @bind="_to" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary" disabled="@_loading">
            @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Xem
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetRangeAsync" disabled="@_loading">30 ngày gần nhất</button>
    </form>
</div>

<ErrorAlert Message="@_error" OnRetry="LoadAsync" />

@if (_loading && _data == null)
{
    <Loading />
}
else if (_data is { } d)
{
    <p class="small text-secondary">Số liệu "mới" tính trong khoảng @Fmt.Date(d.From) – @Fmt.Date(d.To); số liệu hiện tại (tổng người dùng, tin đang hiển thị, đang chờ) tính tại thời điểm xem.</p>

    <div class="row g-3 mb-4">
        @Kpi("Tổng người dùng", d.TotalUsers.ToString("N0"), "bi-people", "primary", null)
        @Kpi("Người dùng mới", d.NewUsers.ToString("N0"), "bi-person-plus", "success", null)
        @Kpi("Tin mới – có phòng", d.NewPostsHasRoom.ToString("N0"), "bi-house-door", "info", null)
        @Kpi("Tin mới – tìm phòng", d.NewPostsSeeking.ToString("N0"), "bi-search", "info", null)
        @Kpi("Tin đang hiển thị", d.ActivePosts.ToString("N0"), "bi-eye", "success", null)
        @Kpi("Tin chờ duyệt", d.PendingPosts.ToString("N0"), "bi-hourglass-split", "warning", "/moderator/posts")
        @Kpi("Báo cáo chờ xử lý", d.PendingReports.ToString("N0"), "bi-flag", "danger", "/moderator/reports")
        @Kpi("Kết nối thành công", d.AcceptedConnections.ToString("N0"), "bi-people-fill", "primary", null)
        @Kpi("Tỷ lệ duyệt", d.ApprovalRate is { } rate ? $"{rate:0.#}%" : "—", "bi-check2-circle", "success", null, $"{d.ApprovedCount} duyệt / {d.RejectedCount} từ chối")
        @Kpi("Thời gian duyệt TB", d.AvgModerationHours is { } h ? $"{h:0.#} giờ" : "—", "bi-stopwatch", "secondary", null)
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-6">
            @Chart("Tin đăng mới theo ngày", d.DailyPosts)
        </div>
        <div class="col-12 col-xl-6">
            @Chart("Người dùng mới theo ngày", d.DailyUsers)
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">Khu vực có nhiều tin nhất</div>
        @if (d.TopAreas.Count == 0)
        {
            <EmptyState Icon="bi-geo-alt" Text="Chưa có tin đăng trong khoảng thời gian này." />
        }
        else
        {
            var maxArea = Math.Max(1, d.TopAreas.Max(a => a.PostCount));
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th style="width:48px">#</th><th>Khu vực</th><th class="text-end">Số tin</th><th style="width:40%" class="d-none d-md-table-cell"></th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < d.TopAreas.Count; i++)
                        {
                            var a = d.TopAreas[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@a.AreaName</td>
                                <td class="text-end">@a.PostCount</td>
                                <td class="d-none d-md-table-cell">
                                    <div class="progress" style="height:8px"><div class="progress-bar" style="width:@Pct(a.PostCount, maxArea)%"></div></div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private DateOnly? _from;
    private DateOnly? _to;
    private DashboardDto? _data;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        SetDefaultRange();
        await LoadAsync();
    }

    private void SetDefaultRange()
    {
        var today = DateOnly.FromDateTime(Fmt.VnNow);
        _to = today;
        _from = today.AddDays(-29);
    }

    private async Task ResetRangeAsync()
    {
        SetDefaultRange();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        if (_from is { } f && _to is { } t)
        {
            if (f > t) { _error = "Ngày bắt đầu phải trước ngày kết thúc."; return; }
            if (t.DayNumber - f.DayNumber > 366) { _error = "Khoảng thời gian tối đa 1 năm."; return; }
        }
        _loading = true;
        try
        {
            _data = await AdminApi.DashboardAsync(_from, _to);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Pct(int value, int max) =>
        (max <= 0 ? 0 : value * 100.0 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment Kpi(string label, string value, string icon, string color, string? href, string? sub = null) => __builder =>
    {
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-@color-subtle text-@color-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width:42px;height:42px">
                        <i class="bi @icon fs-5"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="small text-secondary">@label</div>
                        <div class="fs-4 fw-semibold lh-sm">@value</div>
                        @if (sub != null)
                        {
                            <div class="small text-secondary">@sub</div>
                        }
                        @if (href != null)
                        {
                            <a href="@href" class="small stretched-link">Xem chi tiết</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment Chart(string title, List<DailyCountDto> points) => __builder =>
    {
        var max = points.Count == 0 ? 0 : points.Max(p => p.Count);
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-semibold">@title</span>
                <span class="small text-secondary">Tổng: @points.Sum(p => p.Count) · Cao nhất: @max</span>
            </div>
            <div class="card-body">
                @if (points.Count == 0)
                {
                    <EmptyState Text="Không có dữ liệu" />
                }
                else
                {
                    <div class="bar-chart" role="img" aria-label="@title">
                        @foreach (var p in points)
                        {
                            <div class="bar" style="height:@Pct(p.Count, max)%" title="@($"{p.Date:dd'/'MM}: {p.Count}")"></div>
                        }
                    </div>
                    <div class="d-flex justify-content-between small text-secondary mt-1">
                        <span>@points[0].Date.ToString("dd'/'MM")</span>
                        <span>@points[^1].Date.ToString("dd'/'MM")</span>
                    </div>
                }
            </div>
        </div>
    };
}
