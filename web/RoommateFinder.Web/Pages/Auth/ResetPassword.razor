@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@inject AuthApi AuthApi

<PageTitle>Đặt lại mật khẩu – RoommateFinder</PageTitle>

<div class="container py-5" style="max-width:440px">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Đặt lại mật khẩu</h1>

            @if (string.IsNullOrWhiteSpace(Token))
            {
                <div class="alert alert-danger d-flex gap-2 mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>Đường dẫn đặt lại mật khẩu không hợp lệ hoặc đã hết hạn. Vui lòng yêu cầu lại.</div>
                </div>
                <a href="/forgot-password" class="btn btn-primary w-100">Yêu cầu đặt lại mật khẩu</a>
            }
            else if (_done != null)
            {
                <div class="alert alert-success d-flex gap-2 mt-3" role="status">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>@_done</div>
                </div>
                <a href="/login" class="btn btn-primary w-100">Đăng nhập</a>
            }
            else
            {
                <p class="text-secondary mb-4">Nhập mật khẩu mới cho tài khoản của bạn.</p>

                <ErrorAlert Message="@_error" />
                @if (_error != null)
                {
                    <div class="small mb-3"><a href="/forgot-password">Yêu cầu đường dẫn mới</a></div>
                }

                <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="reset">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="password">Mật khẩu mới</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="new-password" />
                        <div class="form-text">@PasswordPolicy.Message</div>
                        <ValidationMessage For="() => _model.Password" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="confirm">Nhập lại mật khẩu mới</label>
                        <InputText id="confirm" type="password" class="form-control" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => _model.ConfirmPassword" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Đặt lại mật khẩu
                    </button>
                </EditForm>
            }

            <div class="text-center mt-3 small"><a href="/login"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a></div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    /// <summary>Khớp PasswordPolicy.IsStrong ở backend: 8–100 ký tự, có chữ hoa, chữ thường, chữ số.</summary>
    private const string StrongPassword = @"^(?=.*\p{Lu})(?=.*\p{Ll})(?=.*\d).{8,100}$";

    private readonly ResetModel _model = new();
    private bool _busy;
    private string? _error;
    private string? _done;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var res = await AuthApi.ResetPasswordAsync(new ResetPasswordRequest { Token = Token!.Trim(), NewPassword = _model.Password });
            _done = string.IsNullOrWhiteSpace(res.Message) ? "Đặt lại mật khẩu thành công. Vui lòng đăng nhập bằng mật khẩu mới." : res.Message;
        }
        catch (ApiException ex)
        {
            _error = ex.Message; // token hết hạn / đã dùng / mật khẩu yếu
        }
        finally
        {
            _busy = false;
        }
    }

    private class ResetModel
    {
        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới")]
        [RegularExpression(StrongPassword, ErrorMessage = PasswordPolicy.Message)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập lại mật khẩu mới")]
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu nhập lại không khớp")]
        public string ConfirmPassword { get; set; } = "";
    }
}
