<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container py-5 text-center">
                            <i class="bi bi-shield-lock display-4 text-secondary"></i>
                            <h4 class="mt-3">Bạn không có quyền truy cập trang này</h4>
                            <a href="/" class="btn btn-primary mt-2">Về trang chủ</a>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <Loading />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Không tìm thấy trang</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container py-5 text-center">
                    <div class="display-1 text-secondary">404</div>
                    <h4>Không tìm thấy trang</h4>
                    <a href="/" class="btn btn-primary mt-2">Về trang chủ</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
