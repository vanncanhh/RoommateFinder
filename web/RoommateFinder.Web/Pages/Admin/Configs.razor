@page "/admin/configs"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]
@inject AdminApi AdminApi
@inject ToastService Toast

<PageTitle>Cấu hình hệ thống – RoommateFinder</PageTitle>

<h1 class="h4 mb-3"><i class="bi bi-gear me-2"></i>Cấu hình hệ thống</h1>

<div class="alert alert-info small py-2">
    <i class="bi bi-info-circle me-1"></i>Thay đổi chỉ áp dụng cho các thao tác từ thời điểm lưu trở đi
    (ví dụ: đổi số ngày hiển thị tin không làm thay đổi hạn của các tin đã duyệt trước đó).
</div>

@if (_loading)
{
    <Loading />
}
else if (_error != null)
{
    <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
}
else if (_rows.Count == 0)
{
    <EmptyState Icon="bi-gear" Text="Chưa có tham số cấu hình." />
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tham số</th>
                        <th>Mô tả</th>
                        <th class="text-nowrap">Miền giá trị</th>
                        <th style="min-width:220px">Giá trị</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var r = row;
                        var editable = r.Config.Min != null && r.Config.Max != null;
                        <tr>
                            <td><code class="text-nowrap">@r.Config.ConfigKey</code></td>
                            <td class="small">@(r.Config.Description ?? "—")</td>
                            <td class="small text-nowrap">@(editable ? $"{r.Config.Min} – {r.Config.Max}" : "—")</td>
                            <td>
                                @if (editable)
                                {
                                    <form class="d-flex gap-2" @onsubmit="() => SaveAsync(r)" @onsubmit:preventDefault="true">
                                        <input type="number" step="1" min="@r.Config.Min" max="@r.Config.Max" aria-label="@r.Config.ConfigKey"
                                               class="form-control form-control-sm @(r.Error != null ? "is-invalid" : "")" style="max-width:120px"
                                               @bind="r.Value" @bind:event="oninput" />
                                        <button type="submit" class="btn btn-sm btn-primary text-nowrap" disabled="@(r.Busy || !r.Dirty)">
                                            @if (r.Busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            Lưu
                                        </button>
                                        @if (r.Dirty && !r.Busy)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Hoàn tác" @onclick="() => r.Reset()"><i class="bi bi-arrow-counterclockwise"></i></button>
                                        }
                                    </form>
                                    @if (r.Error != null)
                                    {
                                        <div class="small text-danger mt-1">@r.Error</div>
                                    }
                                }
                                else
                                {
                                    <span>@r.Config.ConfigValue</span> <span class="small text-secondary">(không cho phép sửa)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Row> _rows = new();
    private bool _loading;
    private string? _error;

    private class Row(SystemConfigDto config)
    {
        public SystemConfigDto Config { get; set; } = config;
        public string? Value { get; set; } = config.ConfigValue;
        public string? Error { get; set; }
        public bool Busy { get; set; }
        public bool Dirty => (Value ?? "").Trim() != Config.ConfigValue;

        public void Reset()
        {
            Value = Config.ConfigValue;
            Error = null;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _rows = (await AdminApi.ConfigsAsync()).OrderBy(c => c.ConfigKey).Select(c => new Row(c)).ToList();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync(Row r)
    {
        r.Error = null;
        var text = (r.Value ?? "").Trim();
        if (!int.TryParse(text, System.Globalization.NumberStyles.AllowLeadingSign, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            r.Error = "Giá trị phải là số nguyên.";
            return;
        }
        if (value < r.Config.Min || value > r.Config.Max)
        {
            r.Error = $"Giá trị phải từ {r.Config.Min} đến {r.Config.Max}.";
            return;
        }

        r.Busy = true;
        try
        {
            r.Config = await AdminApi.UpdateConfigAsync(r.Config.ConfigKey, value.ToString(System.Globalization.CultureInfo.InvariantCulture));
            r.Value = r.Config.ConfigValue;
            Toast.Success($"Đã lưu {r.Config.ConfigKey} = {r.Config.ConfigValue}.");
        }
        catch (ApiException ex)
        {
            r.Error = ex.Message;
            Toast.Error(ex);
        }
        finally
        {
            r.Busy = false;
        }
    }
}
